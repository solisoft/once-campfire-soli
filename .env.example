SOLIDB_HOST=http://localhost:6745
SOLIDB_DATABASE=once_campfire_soli
SOLIDB_USERNAME=admin
SOLIDB_PASSWORD=admin

# SoliDB's native driver protocol (MessagePack over pooled connections) instead of HTTP/JSON.
SOLI_DB_DRIVER=1

SOLI_NAV=off
SOLI_PREFETCH=off

# Required. Signs the session cookie and every signed id; keep it across restarts.
SECRET_KEY_BASE=
# Set when the app is served over plain HTTP (no TLS in front).
# DISABLE_SSL=1
# Web Push (P-256 VAPID pair, URL-safe Base64). vapid_generate_keys() makes one.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Soli's own session (CSRF token, flash, return-to) lives in a sealed cookie; 32+ chars.
SOLI_SESSION_DRIVER=cookie
SOLI_SESSION_SECRET=
