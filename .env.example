# The whole app is one SQLite file (WAL, synchronous=NORMAL); attachments are files under
# storage/blobs. A pool of 9 connections, like the Rust port's 8 readers and 1 writer.
SOLI_DB_ADAPTER=sqlite
DATABASE_URL=sqlite://storage/campfire.sqlite3
SOLI_DB_POOL_SIZE=9

SOLI_NAV=off
SOLI_PREFETCH=off

# Required. Signs the session cookie and every signed id; keep it across restarts.
SECRET_KEY_BASE=
# Set when the app is served over plain HTTP (no TLS in front).
# DISABLE_SSL=1
# Web Push (P-256 VAPID pair, URL-safe Base64). vapid_generate_keys() makes one.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Soli's own session (CSRF token, flash, return-to) lives in a sealed cookie; 32+ chars.
SOLI_SESSION_DRIVER=cookie
SOLI_SESSION_SECRET=
