#!/usr/bin/env python3
"""Build public/assets the way Propshaft 1.2.1 precompiles the reference app.

Load path, digests and the CSS/JS URL compilers follow the gem (lib/propshaft/*), so the
digested paths and compiled bytes match `rails assets:precompile`. Port-owned files in
overrides/ come first on the load path and shadow the reference's assets of the same
logical path.

Writes:
  public/assets/<digested path>          every asset, compiled when it is CSS or JS
  app/helpers/asset_manifest.sl          asset_path() for views, stylesheet and importmap tags
  app/services/asset_manifest.sl         AssetManifest.path() for controllers and services
"""

import hashlib
import json
import os
import re
import shutil
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VERSION = "1.0"  # config.assets.version in the reference
PREFIX = "/assets"

LOAD_PATH = [
    "overrides",
    "reference/app/assets/images",
    "reference/app/assets/sounds",
    "reference/app/assets/stylesheets",
    "reference/app/javascript",
    "reference/vendor/javascript",
    "vendor/lexxy/app/assets/javascript",
    "vendor/lexxy/app/assets/stylesheets",
    "vendor/stimulus-rails/app/assets/javascripts",
    "vendor/turbo-rails/app/assets/javascripts",
    "vendor/actiontext/app/assets/javascripts",
    "vendor/action_text-trix/app/assets/javascripts",
    "vendor/action_text-trix/app/assets/stylesheets",
    "vendor/actioncable/app/assets/javascripts",
    "vendor/activestorage/app/assets/javascripts",
    "vendor/actionview/app/assets/javascripts",
]

# Edits applied to vendored files on the way in, so vendor/ stays byte-for-byte the gems.
# See OVERRIDES.md.
CABLE_PROTOCOL = (
    "return indexOf.call(supportedProtocols, this.getProtocol()) >= 0;",
    'return this.getProtocol() === "" || indexOf.call(supportedProtocols, this.getProtocol()) >= 0;',
)
# The server sends no pings (a Soli app has no in-process timer to send them from), so an
# open socket is never stale; a closed one still reconnects after staleThreshold seconds.
CABLE_STALENESS = (
    "return secondsSince(this.refreshedAt) > this.constructor.staleThreshold;",
    "return !this.connection.isOpen() && secondsSince(this.refreshedAt) > this.constructor.staleThreshold;",
)
PATCHES = {
    "turbo.js": [CABLE_PROTOCOL, CABLE_STALENESS],
    "actioncable.esm.js": [CABLE_PROTOCOL, CABLE_STALENESS],
}

WS = r"[ \t\n\x0B\x0C\r]"


def quoted_url(head, excluded):
    return re.compile(
        head + r"\(" + WS + r"*[\"']?(?!(?:" + excluded + r"))([^\"' \t\n\x0B\x0C\r?#)]+)([#?][^\"')]+)?" + WS + r"*[\"']?\)"
    )


CSS_ASSET_URLS = quoted_url("url", r"\#|%23|data:|http:|https:|//")
JS_ASSET_URLS = quoted_url("RAILS_ASSET_URL", r"\#|%23|data|http|//")
SOURCE_MAPPING_URLS = re.compile(r"(//|/\*)# sourceMappingURL=(.+\.map)(" + WS + r"*?\*/)?" + WS + r"*?(?=\n?\Z)")
URL_PREFIX_IN_SOURCE_MAP = re.compile(r"(?m)^(.+/)?" + re.escape(PREFIX.strip("/")) + "/")
ALREADY_DIGESTED = re.compile(r"-([0-9a-zA-Z_-]{7,128})\.digested")


class LoadPath:
    def __init__(self):
        self.assets = []
        self.by_logical = {}
        for rel in LOAD_PATH:
            base = os.path.join(ROOT, rel)
            if not os.path.isdir(base):
                continue
            files = []
            for dirpath, _, names in os.walk(base):
                for name in names:
                    files.append(os.path.join(dirpath, name))
            for path in sorted(files):
                if os.path.basename(path).startswith("."):
                    continue
                logical = os.path.relpath(path, base)
                if logical in self.by_logical or logical.endswith(".md"):
                    continue
                with open(path, "rb") as f:
                    content = f.read()
                self.by_logical[logical] = len(self.assets)
                self.assets.append({"logical": logical, "content": content})
        self._digests = {}
        for logical, edits in PATCHES.items():
            i = self.find(logical)
            if i is None:
                sys.exit("patch: no asset %s" % logical)
            text = self.assets[i]["content"].decode("utf-8")
            for old, new in edits:
                if old not in text:
                    sys.exit("patch: %s no longer contains %r" % (logical, old))
                text = text.replace(old, new)
            self.assets[i]["content"] = text.encode("utf-8")

    def find(self, logical):
        return self.by_logical.get(logical)

    def kind(self, i):
        ext = os.path.splitext(self.assets[i]["logical"])[1]
        return {".css": "css", ".js": "js"}.get(ext, "other")

    def pattern(self, i):
        return {"css": CSS_ASSET_URLS, "js": JS_ASSET_URLS}.get(self.kind(i))

    def text(self, i):
        return self.assets[i]["content"].decode("latin-1")

    def referenced_by(self, i):
        pattern = self.pattern(i)
        refs = []
        if pattern:
            self._collect(i, pattern, refs)
        return refs

    def _collect(self, i, pattern, refs):
        directory = os.path.dirname(self.assets[i]["logical"])
        for m in pattern.finditer(self.text(i)):
            url = m.group(1).encode("latin-1").decode("utf-8", "replace")
            found = self.find(resolve(directory, url))
            if found is not None and found not in refs:
                refs.append(found)
                self._collect(found, pattern, refs)

    def digest(self, i):
        if i not in self._digests:
            h = hashlib.sha1(self.assets[i]["content"])
            for ref in self.referenced_by(i):
                h.update(self.assets[ref]["content"])
            h.update(VERSION.encode())
            self._digests[i] = h.hexdigest()[:8]
        return self._digests[i]

    def digested_path(self, i):
        logical = self.assets[i]["logical"]
        if ALREADY_DIGESTED.search(logical):
            return logical
        dot = digestable_extension_start(logical)
        if dot is None:
            return logical
        return logical[:dot] + "-" + self.digest(i) + logical[dot:]

    def compiled(self, i):
        pattern = self.pattern(i)
        if pattern is None:
            return self.assets[i]["content"]
        directory = os.path.dirname(self.assets[i]["logical"])
        is_css = self.kind(i) == "css"

        def replace_url(m):
            url = m.group(1)
            fingerprint = m.group(2) or ""
            found = self.find(resolve(directory, url.encode("latin-1").decode("utf-8", "replace")))
            if found is not None:
                replacement = '"%s/%s%s"' % (PREFIX, self.digested_path(found), fingerprint)
            else:
                replacement = '"%s"' % url
            return "url(%s)" % replacement if is_css else replacement

        output = pattern.sub(replace_url, self.text(i))

        logical = self.assets[i]["logical"]

        def replace_source_map(m):
            start, url, end = m.group(1), m.group(2), m.group(3) or ""
            url = URL_PREFIX_IN_SOURCE_MAP.sub("", url)
            directory = os.path.dirname(logical)
            resolved = url if directory in ("", ".") else os.path.normpath(os.path.join(directory, url))
            found = self.find(resolved)
            if found is not None:
                return "%s# sourceMappingURL=%s/%s%s" % (start, PREFIX, self.digested_path(found), end)
            return start + end

        output = SOURCE_MAPPING_URLS.sub(replace_source_map, output)
        return output.encode("latin-1")


def digestable_extension_start(path):
    # Propshaft: logical_path.sub(/\.(\w+(\.\w+)*)\z/) — the leftmost such match.
    m = re.search(r"\.(\w+(\.\w+)*)\Z", path)
    return m.start() if m else None


def resolve(directory, filename):
    # Propshaft::Compiler#resolve_path, with the directory as a Pathname.
    if filename.startswith("../"):
        return os.path.normpath(os.path.join(directory, filename))
    if filename.startswith("/"):
        return filename[1:]
    if filename.startswith("./"):
        filename = filename[2:]
    return filename if directory in ("", ".") else directory + "/" + filename


# --- importmap (config/importmap.rb in the reference) -------------------------------------

PINS = [
    ("application", "application.js"),
    ("@hotwired/stimulus", "stimulus.min.js"),
    ("@hotwired/stimulus-loading", "stimulus-loading.js"),
    ("@hotwired/turbo-rails", "turbo.js"),
    ("@rails/actioncable", "actioncable.esm.js"),
    ("@rails/request.js", "@rails--request.js"),
    ("lexxy", "lexxy.js"),
    ("highlight.js", "highlight.js/core.js"),
]

PIN_ALL_FROM = [
    ("reference/app/javascript/initializers", "initializers"),
    ("reference/app/javascript/lib", "lib"),
    ("reference/app/javascript/channels", "channels"),
    ("reference/app/javascript/controllers", "controllers"),
    ("reference/app/javascript/helpers", "helpers"),
    ("reference/app/javascript/models", "models"),
    ("reference/vendor/javascript/languages", "languages"),
]


def importmap(load_path):
    pins = list(PINS)
    for directory, under in PIN_ALL_FROM:
        base = os.path.join(ROOT, directory)
        if not os.path.isdir(base):
            continue
        files = []
        for dirpath, _, names in os.walk(base):
            for name in names:
                if name.endswith(".js"):
                    files.append(os.path.relpath(os.path.join(dirpath, name), base))
        for rel in sorted(files):
            module = re.sub(r"(?:/|^)index$", "", rel[: -len(".js")])
            name = "/".join(x for x in [under, module] if x)
            pins.append((name, under + "/" + rel))

    imports = {}
    for name, logical in pins:
        found = load_path.find(logical)
        if found is None:
            sys.exit("importmap: no asset for %s (%s)" % (name, logical))
        imports[name] = PREFIX + "/" + load_path.digested_path(found)
    return imports


def soli_string(value):
    # A double-quoted Soli literal: JSON escaping plus "#{" kept from interpolating.
    return json.dumps(value, ensure_ascii=False).replace("#{", "#\\u{7b}")


def main():
    load_path = LoadPath()
    out = os.path.join(ROOT, "public", "assets")
    if os.path.isdir(out):
        shutil.rmtree(out)
    manifest = {}
    for i, asset in enumerate(load_path.assets):
        digested = load_path.digested_path(i)
        target = os.path.join(out, digested)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "wb") as f:
            f.write(load_path.compiled(i))
        manifest[asset["logical"]] = digested

    stylesheets = sorted(l for l in manifest if l.endswith(".css"))
    stylesheet_tags = "\n".join(
        '<link rel="stylesheet" href="%s/%s" data-turbo-track="reload" />' % (PREFIX, manifest[l]) for l in stylesheets
    )

    imports = importmap(load_path)
    importmap_json = json.dumps({"imports": imports}, indent=2)
    preloads = "\n".join('<link rel="modulepreload" href="%s">' % url for url in imports.values())
    importmap_tags = (
        '<script type="importmap" data-turbo-track="reload">%s</script>\n%s\n<script type="module">import "application"</script>'
        % (importmap_json, preloads)
    )

    entries = ",\n    ".join("%s: %s" % (soli_string(k), soli_string(PREFIX + "/" + v)) for k, v in sorted(manifest.items()))

    with open(os.path.join(ROOT, "app", "helpers", "asset_manifest.sl"), "w") as f:
        f.write(
            "# Generated by bin/build-assets — do not edit.\n\n"
            "# The digested URL of an asset, by logical path (Propshaft's asset_path).\n"
            "def asset_path(logical_path)\n"
            "  paths = I18n.cached_table(\"__asset_paths\") ?? I18n.cache_table(\"__asset_paths\", asset_paths_table())\n"
            "  paths[logical_path] ?? \"/\" + logical_path\n"
            "end\n\n"
            "def asset_paths_table\n  {\n    %s\n  }\nend\n\n"
            "def stylesheet_link_tags\n  %s\nend\n\n"
            "def javascript_importmap_tags\n  %s\nend\n" % (entries, soli_string(stylesheet_tags), soli_string(importmap_tags))
        )

    os.makedirs(os.path.join(ROOT, "app", "services"), exist_ok=True)
    with open(os.path.join(ROOT, "app", "services", "asset_manifest.sl"), "w") as f:
        f.write(
            "# Generated by bin/build-assets — do not edit.\n\n"
            "class AssetManifest\n"
            "  static PATHS: Hash = {\n    %s\n  }\n\n"
            "  static def path(logical_path)\n"
            "    AssetManifest.PATHS[logical_path] ?? \"/\" + logical_path\n"
            "  end\n"
            "end\n" % entries
        )

    print("%d assets, %d stylesheets, %d importmap pins" % (len(manifest), len(stylesheets), len(imports)))


if __name__ == "__main__":
    main()
