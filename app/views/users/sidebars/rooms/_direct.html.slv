<% members = membership["others"] %>
  <a id="list_room_<%= membership["room"]["_key"] %>" class="direct<%= membership["unread_at"].nil? ? "" : " unread" %>" data-sorted-list-number="<%= membership["room"]["updated_at"] %>" data-rooms-list-target="room" data-room-id="<%= membership["room"]["_key"] %>" data-badge-dot-target="unread" data-sorted-list-target="item" href="/rooms/<%= membership["room"]["_key"] %>">
<% if members.length > 1 %>
      <div class="avatar__group">
<% for member in members.take(4) %>
          <span class="avatar">
            <%- image_tag(member["avatar_path"], {"size": 20, "aria": {"hidden": "true"}}) %>
          </span>
<% end %>
      </div>
<% else %>
      <span class="avatar">
        <%- image_tag(members[0]["avatar_path"], {"size": 48, "aria": {"hidden": "true"}}) %>
      </span>
<% end %>

    <span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
      <span class="txt-nowrap overflow-ellipsis">
        <span class="for-screen-reader">Ping with</span>
<% if members.length > 1 %>
          <%= direct_initials(members) %>
<% else %>
          <%= members[0]["name"].split(" ")[0] %>
<% end %>
      </span>
    </span>
</a>
