<%- button_to("/rooms/directs", {"class": "direct borderless fill-transparent unpad", "params": {"user_ids[]": [user["_key"]]}}, "<span class=\"avatar\">" + image_tag(user["avatar_path"], {"aria": {"hidden": "true"}}) + "</span><span class=\"direct__author flex align-center gap max-width min-width border-radius txt-small\"><span class=\"txt-nowrap overflow-ellipsis\"><span class=\"for-screen-reader\">Start a ping with</span>" + html_escape(user["name"].split(" ")[0]) + "</span></span>") %>
