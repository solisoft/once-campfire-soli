<% if user["status"] == "active" %>
  <form class="button_to" method="post" action="/users/<%= user["_key"] %>/ban"><button class="btn full-width" data-turbo-confirm="Are you sure you want to ban this user? This will log them out, delete their messages, and block their IP addresses." type="submit">
    <%- image_tag("cancel.svg", {"aria": {"hidden": "true", "label": "Ban " + user["name"]}}) %>
    <span>Ban <%= user["name"] %></span>
</button></form>
<% else %>
  <form class="button_to" method="post" action="/users/<%= user["_key"] %>/ban"><%- method_hidden_field("delete") %><button class="btn btn--negative full-width" data-turbo-confirm="Are you sure you want to remove the ban on this user?" type="submit">
    <%- image_tag("cancel.svg", {"aria": {"hidden": "true", "label": "Remove Ban " + user["name"]}}) %>
    <span>Remove ban</span>
</button></form>
<% end %>
