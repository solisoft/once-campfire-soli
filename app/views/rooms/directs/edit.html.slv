<% content_for "nav" do %>
  <div class="flex-item-justify-start">
    <%- link_back_to(@back_path) %>
  </div>
<% end %>

<div class="panel txt-align-center">
  <section class="directs--edit margin-block-end">
<% for user in @users %>
      <div class="member flex flex-column gap fill-shade pad border-radius">
        <figure class="avatar center" style="--avatar-border-radius: 10ch; --avatar-size: 10ch;" >
          <%- avatar_tag(user, {"loading": "lazy"}) %>
        </figure>

        <strong><%= user["name"] %></strong>
      </div>
<% end %>
  </section>

  <%- button_to(@delete_room_url, {"method": "delete", "class": "btn btn--negative center", "aria": {"label": "Delete Ping"}, "data": {"turbo_confirm": "Are you sure you want to delete this ping and all messages in it? This can’t be undone."}}, "\n    " + image_tag("trash.svg", {"aria": {"hidden": "true"}}) + "\n    Ping\n") %></div>
