<turbo-frame id="boosting_message_<%= m["client_message_id"] %>">
  <div class="boosts flex flex-wrap align-center gap full-width" style="--column-gap: 0.4ch; --row-gap: 0"
      data-controller="turbo-streaming" data-action="turbo:submit-start->turbo-streaming#unsubscribe">
    <div class="flex-inline flex-wrap gap" id="boosts_message_<%= m["client_message_id"] %>" data-turbo-streaming-target="container">
<% for boost in m["boosts"] %><%- partial("messages/boosts/boost", {"boost": boost}) %><% end %>
    </div>

    <turbo-frame id="new_boost_message_<%= m["client_message_id"] %>">
      <div class="flex-inline message__boost-inline" data-controller="soft-keyboard">
        <a class="boost__action txt-small btn" action="soft-keyboard#open" href="/messages/<%= m["_key"] %>/boosts/new">
          <%- image_tag("boost.svg", {"size": 20, "aria": {"hidden": "true"}}) %>
          <span class="for-screen-reader">Add a boost</span>
</a>      </div>
</turbo-frame>  </div>
</turbo-frame>
