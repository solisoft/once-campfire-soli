<% if a["kind"] == "video" %><div class="max-inline-size center <%= a["width"].nil? ? "" : "flex " %>overflow-clip"<%- a["frame_style"].nil? ? "" : " style=\"" + a["frame_style"] + "\"" %>><video src="<%= a["blob_path"] %>"<%- a["poster_path"].nil? ? "" : " poster=\"" + a["poster_path"] + "\"" %> controls="controls" preload="none" width="100%" height="100%" class="message__attachment"></video></div><% elsif a["kind"] == "image" %><div class="max-inline-size center <%= a["width"].nil? ? "" : "flex " %>overflow-clip"<%- a["frame_style"].nil? ? "" : " style=\"" + a["frame_style"] + "\"" %>><a class="flex" data-lightbox-target="image" data-action="lightbox#open" data-lightbox-url-value="<%= a["download_path"] %>" href="<%= a["blob_path"] %>"><img<%- a["width"].nil? ? "" : " width=\"" + str(a["width"]) + "\" height=\"" + str(a["height"]) + "\"" %> class="message__attachment" loading="lazy" src="<%= a["thumb_path"] %>" /></a></div><% else %><div class="flex-inline align-center gap-half"><%- image_tag("common-file-text.svg", {"size": 22, "class": "colorize--black", "aria": {"hidden": "true"}}) %><span><%= a["filename"] %></span><a class="btn message__action-btn hide-in-ios-pwa" style="--width: auto;" href="<%= a["download_path"] %>"><%- image_tag("download.svg", {"aria": {"hidden": "true"}, "size": 20}) %><span class="for-screen-reader">Download <%= a["filename"] %></span></a><button class="btn message__action-btn" style="--width: auto;" data-controller="web-share" data-action="web-share#share" data-web-share-files-value="<%= a["download_path"] %>"><%- image_tag("share.svg", {"aria": {"hidden": "true"}, "size": 20}) %><span class="for-screen-reader">Share <%= a["filename"] %></span></button></div><% end %>
