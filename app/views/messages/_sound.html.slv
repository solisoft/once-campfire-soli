<div class="sound" data-controller="sound" data-action="messages:play->sound#play" data-sound-url-value="<%= sound["asset_path"] %>"><button class="btn btn--plain" data-action="sound#play">🔊</button><% if sound["image"].nil? %><%= sound["text"] %><% else %><%- image_tag(sound["image_path"], {"width": sound["width"], "height": sound["height"], "class": "align--middle"}) %><% end %></div>
