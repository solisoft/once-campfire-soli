<!DOCTYPE html>
<html>
  <head>
    <title><%= @page_title ?? "Campfire" %></title>

    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="csrf-param" content="_csrf_token" />
    <meta name="csrf-token" content="<%= @csrf ?? csrf_token() %>" />
<% unless @layout["user"].nil? %>
    <meta name="current-user-id" content="<%= @layout["user"]["_key"] %>" /><meta name="current-user-name" content="<%= @layout["user"]["name"] %>" />
<% end %>
    <meta name="action-cable-url" content="/cable" />

    <meta name="vapid-public-key" content="<%= @layout["vapid_public_key"] %>">
    <meta name="turbo-prefetch" content="true">

    <link rel="manifest" href="/webmanifest.json">
    <link rel="icon" href="<%= @layout["logo_path"] %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= @layout["logo_path"] %>">

    <%- stylesheet_link_tags() %>
<% unless @layout["custom_styles"].blank? %>
    <style data-turbo-track="reload"><%- @layout["custom_styles"] %></style>
<% end %>

    <%- javascript_importmap_tags() %>

    <%- yield "head" %>
  </head>

  <body class="<%= [@body_class, @layout["admin_and_logo_classes"]].filter { |c| !c.blank? }.join(" ") %>" data-controller="local-time lightbox">
    <a href="#main-content" class="skip-navigation btn">Skip to main content</a>

    <nav id="nav">
      <%- yield "nav" %>
    </nav>

<% notice = @flash_notice ?? @flash_alert %>
<% unless notice.nil? %>
    <div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove">
      <div class="flash__inner shadow" style="<%= @flash_alert.nil? ? "" : "--flash-background: var(--color-negative)" %>">
<% if @flash_alert.nil? %>
          <%- image_tag("check.svg", {"aria": {"hidden": true}, "size": 24, "class": "colorize--white"}) %></span>
<% else %>
          <%- image_tag("alert.svg", {"aria": {"hidden": true}, "size": 24, "class": "colorize--white"}) %></span>
<% end %>
      </div>
      <span class="for-screen-reader" role="alert" aria-atomic="true"><%= notice %></span>
    </div>
<% end %>

    <main id="main-content">
      <%- yield %>

      <footer id="footer">
        <%- yield "footer" %>
      </footer>
    </main>

    <aside id="sidebar" data-controller="toggle-class" data-toggle-class-toggle-class="open">
      <%- yield "sidebar" %>
    </aside>

    <%- partial("layouts/lightbox") %>

    <a href="https://once.com" id="app-logo" target="_blank" aria-label="Once software from 37signals home page">
      <%- image_tag("campfire-icon.png", {"alt": "Campfire logo", "width": 256, "height": 216}) %>
    </a>
  </body>
</html>
